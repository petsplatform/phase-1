VITE_API_URL=http://localhost:5000/api
VITE_PUBLIC_APP_URL=http://localhost:5173
# Browser-safe Google OAuth Web Client ID.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-api-key
# Optional ISO country code restriction for Places Autocomplete. Leave empty to allow global search.
VITE_GOOGLE_MAPS_COUNTRY=
# Optional. Keep false/empty to use backend OAuth redirect flow.
VITE_GOOGLE_USE_POPUP=
VITE_STORE_KEY=STORE_1
VITE_STORE_DOMAIN=
VITE_SOCIAL_AUTH_CALLBACK_PATH=/auth/social/callback
# Optional overrides when the backend social login start URLs differ.
VITE_GOOGLE_AUTH_URL=
VITE_APPLE_AUTH_URL=
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_PINTEREST_URL=
VITE_YOUTUBE_URL=



