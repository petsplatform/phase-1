generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  Active
  Inactive
}

enum OrderStatus {
  Pending
  Confirmed
  Processing
  Shipped
  Delivered
  Cancelled
}

enum PaymentStatus {
  Paid
  Pending
  Failed
  Refunded
}

enum AutoOrderStatus {
  ACTIVE
  PAUSED
  PAYMENT_FAILED
  OUT_OF_STOCK
  PRESCRIPTION_REQUIRED
  CANCELLED
  COMPLETED
}

enum AutoOrderFrequencyType {
  DAYS
}

enum AutoOrderExecutionStatus {
  PENDING
  PROCESSING
  SUCCESS
  PAYMENT_FAILED
  OUT_OF_STOCK
  PRESCRIPTION_REQUIRED
  FAILED
  CANCELLED
}

enum AutoOrderPaymentStatus {
  NOT_ATTEMPTED
  REQUIRES_PAYMENT_METHOD
  PROCESSING
  PAID
  FAILED
}

enum ShipmentStatus {
  Pending
  Packed
  ReadyToShip
  Shipped
  InTransit
  OutForDelivery
  Delivered
  Cancelled
  Returned
  FailedDelivery
}

enum InquiryStatus {
  New
  InProgress
  Resolved
}

enum VetVerificationStatus {
  Pending
  Approved
  Rejected
  Expired
}

enum StoreStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  SUSPENDED
}

enum StoreRole {
  SUPER_ADMIN
  STORE_ADMIN
  STORE_MANAGER
  STORE_STAFF
}

enum ProvisioningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SupportConversationStatus {
  OPEN
  WAITING_FOR_AGENT
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportSource {
  WEBSITE
  PETGPT
  ORDER
  PRODUCT
  CHECKOUT
}

enum SupportSenderType {
  CUSTOMER
  AGENT
  SYSTEM
  BOT
}

enum SupportMessageType {
  TEXT
  IMAGE
  FILE
  ORDER_REFERENCE
  PRODUCT_REFERENCE
  SYSTEM
  INTERNAL_NOTE
}

enum PetGPTRiskLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum PetGPTMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiCallAgentLanguage {
  english
  hindi
  gujarati
  multilingual
}

enum AiCallLeadStatus {
  new
  queued
  calling
  interested
  not_interested
  callback_requested
  information_sent
  do_not_call
  no_answer
  failed
  completed
}

enum AiCallCampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
}

enum AiCallStatus {
  queued
  calling
  ringing
  answered
  completed
  no_answer
  busy
  voicemail
  failed
  cancelled
}

enum AiCallOutcome {
  interested
  not_interested
  callback_requested
  information_sent
  no_answer
  busy
  voicemail
  failed
  do_not_call
  completed
}

enum AiCallMessageRole {
  customer
  agent
  system
  tool
}

enum AiCallActionStatus {
  pending
  success
  failed
  skipped
}

enum AiCallConsentStatus {
  unknown
  opted_in
  opted_out
}

model AdminUser {
  id               String                @id @default(cuid())
  name             String
  role             String                @default("Store Owner")
  email            String                @unique
  passwordHash     String
  avatar           String?
  storeAssignments UserStoreAssignment[]
  auditLogs        MasterAuditLog[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model Store {
  id                    String             @id @default(uuid())
  name                  String
  slug                  String             @unique
  storeKey              String             @unique
  primaryDomain         String             @unique
  databaseName          String
  databaseHost          String
  databasePort          Int                @default(5432)
  databaseUser          String
  encryptedDatabasePass String
  databaseSchema        String             @default("public")
  status                StoreStatus        @default(PENDING)
  provisioningStatus    ProvisioningStatus @default(NOT_STARTED)
  provisioningError     String?
  provisioningStep      String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  users     UserStoreAssignment[]
  domains   StoreDomain[]
  auditLogs MasterAuditLog[]

  @@index([status])
  @@index([storeKey])
}

model StoreDomain {
  id        String   @id @default(uuid())
  storeId   String
  domain    String   @unique
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([domain])
}

model UserStoreAssignment {
  id        String    @id @default(uuid())
  userId    String
  storeId   String
  role      StoreRole @default(STORE_ADMIN)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model MasterAuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  storeId   String?
  action    String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  store Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([storeId])
  @@index([action])
  @@index([createdAt])
}

model MasterWebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String   @unique
  storeId     String?
  type        String
  processedAt DateTime @default(now())

  @@index([storeId])
}

model Category {
  id          String       @id
  name        String       @unique
  description String?
  image       String?
  status      RecordStatus @default(Active)
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Product {
  id                   String                @id
  name                 String
  slug                 String?               @unique
  description          String?
  parentContent        String?
  productDetails       Json                  @default("{}")
  productType          String                @default("SIMPLE")
  familyVariants       Json                  @default("[]")
  seoTitle             String?
  seoDescription       String?
  price                Float
  salePrice            Float?
  stock                Int                   @default(0)
  sold                 Int                   @default(0)
  sku                  String                @unique
  status               RecordStatus          @default(Active)
  image                String?
  gallery              String[]              @default([])
  petType              String?
  optionType           String                @default("size")
  optionLabel          String?
  capacities           String[]              @default([])
  colorVariants        Json?
  optionVariants       Json?
  shippingReturns      String?
  returnPolicies       String?
  prescriptionRequired Boolean               @default(false)
  vetOnly              Boolean               @default(false)
  categoryId           String?
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  autoOrders           AutoOrder[]
  supportConversations SupportConversation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([stock])
  @@index([categoryId])
  @@index([productType])
}

model Customer {
  id                   String                      @id
  name                 String
  email                String                      @unique
  passwordHash         String?
  phone                String?
  avatar               String?
  addresses            String[]                    @default([])
  cartItems            Json                        @default("[]")
  wishlistItems        Json                        @default("[]")
  status               RecordStatus                @default(Active)
  blockedReason        String?
  whatsappNumber       String?
  petType              String?
  petName              String?
  city                 String?
  notes                String?
  leadStatus           AiCallLeadStatus            @default(new)
  consentStatus        AiCallConsentStatus         @default(unknown)
  doNotCall            Boolean                     @default(false)
  rewardPoints         Int                         @default(0)
  rewardSignupGranted  Boolean                     @default(false)
  abandonedCartEmailSentAt DateTime?
  abandonedCartEmailCartHash String?
  abandonedCartEmailCount Int                      @default(0)
  isVetVerified        Boolean                     @default(false)
  vetVerifiedAt        DateTime?
  joined               DateTime                    @default(now())
  orders               Order[]
  autoOrders           AutoOrder[]
  pets                 Pet[]
  petgptConversations  PetGPTConversation[]
  vetVerification      VetVerification?
  supportConversations SupportConversation[]
  supportRatings       SupportRating[]
  aiCampaignCustomers  AiCallCampaignCustomer[]
  aiCalls              AiCall[]
  aiLeadHistory        CustomerLeadStatusHistory[]
  aiCallbacks          AiCallCallback[]
  rewardTransactions   RewardTransaction[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([joined])
  @@index([isVetVerified])
  @@index([leadStatus])
  @@index([doNotCall])
  @@index([rewardPoints])
  @@index([abandonedCartEmailSentAt])
  @@index([city])
  @@index([petType])
}

model NewsletterSubscriber {
  id                      String       @id @default(cuid())
  email                   String       @unique
  name                    String?
  source                  String       @default("website")
  status                  RecordStatus @default(Active)
  topics                  String[]     @default(["pet_essentials", "pet_care_tips", "offers"])
  confirmedAt             DateTime?
  lastConfirmationEmailAt DateTime?
  lastUpdateEmailAt       DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([lastUpdateEmailAt])
}

model RewardTransaction {
  id          String   @id @default(cuid())
  customerId  String
  type        String
  points      Int
  balanceAfter Int
  orderId     String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
  @@index([orderId])
  @@index([createdAt])
}

model CustomerLeadStatusHistory {
  id             String            @id @default(cuid())
  customerId     String
  previousStatus AiCallLeadStatus?
  nextStatus     AiCallLeadStatus
  reason         String?
  source         String            @default("ai_calling")
  callId         String?
  createdBy      String?
  createdAt      DateTime          @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  call     AiCall?  @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([callId])
  @@index([nextStatus])
  @@index([createdAt])
}

model AiCallAgent {
  id             String              @id @default(cuid())
  name           String
  purpose        String
  systemPrompt   String
  language       AiCallAgentLanguage @default(multilingual)
  voice          Json?
  openingMessage String
  allowedActions Json                @default("[]")
  active         Boolean             @default(true)
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  campaigns AiCallCampaign[]
  calls     AiCall[]

  @@index([active])
  @@index([createdAt])
}

model AiCallCampaign {
  id                  String               @id @default(cuid())
  name                String
  agentId             String
  goal                String
  status              AiCallCampaignStatus @default(DRAFT)
  scheduledStart      DateTime?
  callingHours        Json?
  maxAttempts         Int                  @default(1)
  retryDelayMinutes   Int                  @default(1440)
  maxConcurrentCalls  Int                  @default(1)
  informationTemplate String?
  whatsappTemplate    String?
  emailTemplate       String?
  complianceConfig    Json?
  createdBy           String?
  startedAt           DateTime?
  pausedAt            DateTime?
  stoppedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  agent     AiCallAgent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  customers AiCallCampaignCustomer[]
  calls     AiCall[]
  callbacks AiCallCallback[]

  @@index([agentId])
  @@index([status])
  @@index([scheduledStart])
  @@index([createdAt])
}

model AiCallCampaignCustomer {
  id                  String           @id @default(cuid())
  campaignId          String
  customerId          String
  phone               String
  status              AiCallLeadStatus @default(queued)
  attemptCount        Int              @default(0)
  nextAttemptAt       DateTime?
  lastAttemptAt       DateTime?
  eligibilitySnapshot Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  campaign AiCallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@index([nextAttemptAt])
}

model AiCall {
  id             String         @id @default(cuid())
  campaignId     String?
  customerId     String
  agentId        String
  vobizCallId    String?        @unique
  status         AiCallStatus   @default(queued)
  outcome        AiCallOutcome?
  attempt        Int            @default(1)
  phone          String
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  duration       Int?
  summary        Json?
  usage          Json?
  error          String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaign      AiCallCampaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  customer      Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agent         AiCallAgent                 @relation(fields: [agentId], references: [id], onDelete: Restrict)
  messages      AiCallMessage[]
  actions       AiCallAction[]
  statusHistory CustomerLeadStatusHistory[]
  callbacks     AiCallCallback[]

  @@index([campaignId])
  @@index([customerId])
  @@index([agentId])
  @@index([status])
  @@index([outcome])
  @@index([createdAt])
}

model AiCallMessage {
  id        String            @id @default(cuid())
  callId    String
  role      AiCallMessageRole
  content   String
  language  String?
  metadata  Json?
  createdAt DateTime          @default(now())

  call AiCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([role])
  @@index([createdAt])
}

model AiCallAction {
  id             String             @id @default(cuid())
  callId         String
  type           String
  status         AiCallActionStatus @default(pending)
  idempotencyKey String             @unique
  payload        Json?
  result         Json?
  error          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  call AiCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AiCallCallback {
  id          String   @id @default(cuid())
  customerId  String
  campaignId  String?
  callId      String?
  scheduledAt DateTime
  timezone    String
  notes       String?
  status      String   @default("scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign AiCallCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  call     AiCall?         @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([campaignId])
  @@index([callId])
  @@index([scheduledAt])
  @@index([status])
}

model VetVerification {
  id            String                @id @default(cuid())
  userId        String                @unique
  fullName      String
  clinicName    String
  licenseNumber String                @unique
  licenseState  String
  licenseExpiry DateTime
  phone         String
  email         String
  documentUrl   String
  status        VetVerificationStatus @default(Pending)
  remarks       String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user Customer @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([licenseExpiry])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  recipient String
  userId    String?
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([recipient])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Order {
  id                    String                @id
  customerId            String?
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName          String
  email                 String
  phone                 String?
  orderDate             DateTime              @default(now())
  total                 Float
  subtotal              Float
  shipping              Float                 @default(0)
  tax                   Float                 @default(0)
  discount              Float                 @default(0)
  paymentStatus         PaymentStatus         @default(Pending)
  paymentMethod         String                @default("cod")
  stripePaymentIntentId String?               @unique
  orderStatus           OrderStatus           @default(Pending)
  shippingAddress       String?
  prescriptionUrl       String?
  prescriptions         Json?
  courierName           String?
  trackingNumber        String?               @unique
  awbNumber             String?
  trackingUrl           String?
  shipmentStatus        ShipmentStatus        @default(Pending)
  shipmentCreatedAt     DateTime?
  shippedAt             DateTime?
  outForDeliveryAt      DateTime?
  deliveredAt           DateTime?
  estimatedDeliveryDate DateTime?
  items                 Json
  timeline              String[]              @default([])
  shipmentHistory       ShipmentHistory[]
  autoOrderExecutions   AutoOrderExecution[]
  supportConversations  SupportConversation[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([orderDate])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([shipmentStatus])
  @@index([courierName])
}

model Pet {
  id                 String   @id @default(cuid())
  customerId         String
  name               String?
  species            String?
  breed              String?
  age                String?
  weight             String?
  gender             String?
  neuteredSpayed     Boolean?
  medicalConditions  String[] @default([])
  allergies          String[] @default([])
  currentMedications String[] @default([])
  vaccinationInfo    String?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations PetGPTConversation[]

  @@index([customerId])
  @@index([name])
  @@index([species])
}

model AutoOrder {
  id                      String                 @id @default(cuid())
  customerId              String
  customer                Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId               String?
  variantLabel            String?
  quantity                Int
  frequencyType           AutoOrderFrequencyType @default(DAYS)
  frequencyValue          Int
  firstOrderDate          DateTime
  nextOrderDate           DateTime
  lastOrderDate           DateTime?
  shippingAddressIndex    Int
  shippingAddressSnapshot Json?
  paymentMethod           String                 @default("stripe")
  paymentMethodReference  String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  status                  AutoOrderStatus        @default(ACTIVE)
  autoRenew               Boolean                @default(true)
  failureReason           String?
  retryCount              Int                    @default(0)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  executions AutoOrderExecution[]

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([nextOrderDate])
  @@index([status, nextOrderDate])
}

model AutoOrderExecution {
  id                    String                   @id @default(cuid())
  autoOrderId           String
  autoOrder             AutoOrder                @relation(fields: [autoOrderId], references: [id], onDelete: Cascade)
  orderId               String?
  order                 Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  scheduledDate         DateTime
  processedAt           DateTime?
  status                AutoOrderExecutionStatus @default(PENDING)
  paymentStatus         AutoOrderPaymentStatus   @default(NOT_ATTEMPTED)
  orderStatus           OrderStatus?
  stripePaymentIntentId String?                  @unique
  retryCount            Int                      @default(0)
  failureReason         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([autoOrderId, scheduledDate])
  @@index([autoOrderId])
  @@index([orderId])
  @@index([scheduledDate])
  @@index([status])
}

model ShipmentHistory {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  location    String?
  description String?
  createdBy   String?
  createdAt   DateTime       @default(now())

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model Courier {
  id                 String       @id @default(cuid())
  name               String       @unique
  trackingUrlPattern String?
  status             RecordStatus @default(Active)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
  @@index([name])
}

model ShipmentSettings {
  id                           String   @id @default("default")
  defaultCourierId             String?
  defaultEstimatedDeliveryDays Int      @default(5)
  enableEmailNotifications     Boolean  @default(true)
  enableSmsNotifications       Boolean  @default(false)
  enablePushNotifications      Boolean  @default(true)
  updatedAt                    DateTime @updatedAt
}

model ShipmentCharge {
  id             String       @id @default(cuid())
  label          String
  minOrderAmount Float        @default(0)
  maxOrderAmount Float?
  charge         Float        @default(0)
  status         RecordStatus @default(Active)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([minOrderAmount])
}

model Banner {
  id         String       @id
  title      String
  subtitle   String?
  buttonText String?
  link       String?
  image      String?
  position   String?
  startDate  DateTime?
  endDate    DateTime?
  status     RecordStatus @default(Active)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Inquiry {
  id        String        @id
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  status    InquiryStatus @default(New)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Popup {
  id         String       @id @default("default")
  title      String
  message    String?
  buttonText String?
  link       String?
  image      String?
  status     RecordStatus @default(Active)
  updatedAt  DateTime     @updatedAt
}

model Announcement {
  id        String       @id @default("default")
  text      String
  link      String?
  startDate DateTime?
  endDate   DateTime?
  status    RecordStatus @default(Active)
  updatedAt DateTime     @updatedAt
}

enum DiscountType {
  percentage
  flat
}

model Coupon {
  id         String       @id
  code       String       @unique
  type       DiscountType @default(percentage)
  value      Float        @default(0)
  minOrder   Float        @default(0)
  maxUses    Int          @default(100)
  usageCount Int          @default(0)
  expiry     DateTime?
  status     RecordStatus @default(Active)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model TaxRate {
  id          String       @id
  name        String
  rate        Float        @default(0)
  description String?
  status      RecordStatus @default(Active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

model StoreSettings {
  id           String   @id @default("default")
  storeName    String
  supportEmail String
  supportPhone String?
  currency     String   @default("USD")
  timezone     String   @default("UTC")
  rewardsEnabled Boolean @default(true)
  rewardSignupPoints Int @default(40)
  rewardPointsPerCurrencyUnit Float @default(1)
  rewardPointValue Float @default(0.25)
  rewardMaxRedeemPercent Float @default(20)
  rewardMinRedeemPoints Int @default(1)
  abandonedCartEmailEnabled Boolean @default(false)
  abandonedCartDelayHours Float @default(24)
  abandonedCartDiscountPercent Float @default(10)
  abandonedCartMinimumAmount Float @default(25)
  abandonedCartMaxEmails Int @default(2)
  mobileAppEnabled Boolean @default(false)
  appStoreUrl  String?
  playStoreUrl String?
  smtpEmail    String?
  smtpPass     String?
  smtpHost     String?
  smtpPort     Int?
  updatedAt    DateTime @updatedAt
}

enum ImportStatus {
  Processing
  Completed
  Failed
  PartialSuccess
}

enum ImportMode {
  AddNew
  UpdateExisting
  AddOrUpdate
}

model ProductImportHistory {
  id          String       @id @default(cuid())
  fileName    String
  importedBy  String
  totalRows   Int          @default(0)
  successRows Int          @default(0)
  failedRows  Int          @default(0)
  status      ImportStatus @default(Processing)
  importMode  ImportMode   @default(AddNew)
  durationMs  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  errors ProductImportError[]

  @@index([createdAt])
  @@index([status])
}

model ProductImportError {
  id        String   @id @default(cuid())
  importId  String
  rowNumber Int
  sku       String?
  name      String?
  reason    String
  createdAt DateTime @default(now())

  import ProductImportHistory @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
}

model ProductReview {
  id           String   @id @default(cuid())
  productId    String
  orderId      String
  customerId   String
  customerName String
  rating       Int
  title        String?
  comment      String
  isVerified   Boolean  @default(true)
  helpfulCount Int      @default(0)
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model PetGPTConversation {
  id                String          @id
  customerId        String?
  petId             String?
  intent            String?
  riskLevel         PetGPTRiskLevel @default(LOW)
  status            String          @default("ACTIVE")
  conversationState Json?
  summary           String?
  lastMessageAt     DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pet      Pet?            @relation(fields: [petId], references: [id], onDelete: SetNull)
  messages PetGPTMessage[]
  symptoms PetGPTSymptom[]

  @@index([customerId])
  @@index([petId])
  @@index([intent])
  @@index([riskLevel])
  @@index([lastMessageAt])
}

model PetGPTMessage {
  id              String            @id @default(cuid())
  conversationId  String
  role            PetGPTMessageRole
  content         String
  intent          String?
  riskLevel       PetGPTRiskLevel?
  metadata        Json?
  clientMessageId String?
  createdAt       DateTime          @default(now())

  conversation PetGPTConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId])
  @@index([role])
  @@index([intent])
  @@index([riskLevel])
  @@index([createdAt])
}

model PetGPTSymptom {
  id             String          @id @default(cuid())
  conversationId String
  petId          String?
  symptom        String
  severity       String?
  duration       String?
  riskLevel      PetGPTRiskLevel @default(LOW)
  metadata       Json?
  createdAt      DateTime        @default(now())

  conversation PetGPTConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([petId])
  @@index([symptom])
  @@index([riskLevel])
  @@index([createdAt])
}

model PetGPTAnalyticsEvent {
  id             String   @id @default(cuid())
  conversationId String?
  customerId     String?
  eventType      String
  intent         String?
  riskLevel      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([customerId])
  @@index([eventType])
  @@index([intent])
  @@index([riskLevel])
  @@index([createdAt])
}

model SupportConversation {
  id              String                    @id
  customerId      String
  assignedAgentId String?
  status          SupportConversationStatus @default(WAITING_FOR_AGENT)
  priority        SupportPriority           @default(NORMAL)
  subject         String?
  source          SupportSource             @default(WEBSITE)
  orderId         String?
  productId       String?
  metadata        Json?
  customerUnread  Int                       @default(0)
  agentUnread     Int                       @default(0)
  lastMessageAt   DateTime                  @default(now())
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  rating   SupportRating?

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([orderId])
  @@index([productId])
  @@index([lastMessageAt])
}

model SupportMessage {
  id              String             @id @default(cuid())
  conversationId  String
  senderId        String?
  senderType      SupportSenderType
  message         String
  messageType     SupportMessageType @default(TEXT)
  metadata        Json?
  clientMessageId String?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId])
  @@index([senderType])
  @@index([messageType])
  @@index([createdAt])
}

model SupportRating {
  id             String   @id @default(cuid())
  conversationId String   @unique
  customerId     String
  rating         Int
  feedback       String?
  createdAt      DateTime @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([rating])
  @@index([createdAt])
}

model SupportSettings {
  id                         String   @id @default("default")
  enabled                    Boolean  @default(true)
  supportName                String   @default("Customer Support")
  welcomeMessage             String   @default("Hi! How can we help you today?")
  offlineMessage             String   @default("Our support team is currently unavailable, but you can leave a message.")
  autoAssignmentEnabled      Boolean  @default(false)
  maxConversationsPerAgent   Int      @default(5)
  fileUploadEnabled          Boolean  @default(false)
  ratingEnabled              Boolean  @default(true)
  emailNotificationsEnabled  Boolean  @default(false)
  availability               Json?
  autoCloseResolvedAfterDays Int      @default(7)
  updatedAt                  DateTime @updatedAt
}
