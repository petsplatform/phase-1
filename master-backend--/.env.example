# Customer social login OAuth credentials.
# Google: create an OAuth 2.0 Web client in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Backend OAuth callback registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:5000/api/customer-panel/auth/social/google/callback
# Private server key for reverse geocoding current customer location.
# Enable the Google Geocoding API and restrict this key by server/IP in production.
GOOGLE_GEOCODING_API_KEY=

# Apple: use the Services ID as APPLE_CLIENT_ID and a generated client_secret JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://localhost:5000/api/customer-panel/auth/social/apple/callback
