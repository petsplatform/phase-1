NODE_ENV=development
PORT=5000
PUBLIC_WEBHOOK_PORT=5001
JWT_SECRET=change-me

PETGPT_AI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol
# PETGPT_AI_API_KEY and PETGPT_AI_MODEL are still accepted as legacy fallbacks.

AI_CALLING_ENABLED=false
PUBLIC_API_BASE_URL=http://localhost:5000
# Optional OAuth callback API base. Use your public backend URL in production.
OAUTH_PUBLIC_API_BASE_URL=
STORE_PUBLIC_URL=http://localhost:5173
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
VOBIZ_WEBHOOK_TOKEN=
VOBIZ_MEDIA_STREAM_URL=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_STT_LANGUAGE_CODE=gu-IN
SARVAM_STT_SAMPLE_RATE=8000
SARVAM_STT_AUDIO_CODEC=pcm_l16
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
OPENAI_CALLING_MODEL=gpt-5.6-terra
REDIS_URL=
WHATSAPP_PROVIDER=none

DATABASE_URL=postgresql://user:password@localhost:5432/current_database?schema=public
MASTER_DATABASE_URL=postgresql://user:password@localhost:5432/master_database?schema=public
MULTI_TENANT_ENABLED=false
TENANT_DATABASE_ENCRYPTION_KEY=replace-with-32-byte-or-long-random-secret
TENANT_CLIENT_CACHE_SIZE=25
ALLOW_STORE_KEY_RESOLUTION=false

TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_ADMIN_USER=
TENANT_DB_ADMIN_PASSWORD=
TENANT_DB_APP_USER=
TENANT_DB_APP_PASSWORD=

STORE_1_NAME=
STORE_1_KEY=STORE_1
STORE_1_DOMAIN=
STORE_1_DATABASE=
STORE_1_ADMIN_EMAIL=admin1@store.local
STORE_1_ADMIN_PASSWORD=Store@12345

STORE_2_NAME=
STORE_2_KEY=STORE_2
STORE_2_DOMAIN=
STORE_2_DATABASE=
STORE_2_ADMIN_EMAIL=admin2@store.local
STORE_2_ADMIN_PASSWORD=Store@12345

